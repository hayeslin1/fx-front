    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
    "immer": "11.2.9",
    "lucide-react": "1.62.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
